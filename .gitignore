# ── Python (backend) ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ── Node / frontend ────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local

# ── Env / secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Project runtime data (regenerated, not source) ────────────────
tripwire.db
tripwire.db-journal
tripwire.db-wal
logs/
.tripwire_state/
real_data/

# Decoy files are generated by decoy_gen.py — don't commit generated
# instances, only keep this if you intentionally seed sample decoys.
decoys/*
!decoys/.gitkeep

# ── Reports (generated PDFs) ──────────────────────────────
tripwire.zip
